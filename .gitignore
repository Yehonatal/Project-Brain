# ==============================================================================
# Project Brain - .gitignore
# ==============================================================================

# Local Database & Ingestion Storage (Never commit local session data)
brain.db
brain.db-wal
brain.db-shm
*.db
*.sqlite
*.sqlite3
.brain_data/
ingestion_state.json

# Environment variables & Sensitive Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python Caches & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node & Frontend Build Artifacts
node_modules/
web/node_modules/
web/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Outputs
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# Logs & Temporary Files
*.log
*.tmp
*.bak
*.swp
*~
scratch/

# IDE & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
